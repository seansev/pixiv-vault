#!/bin/sh
set -eu
PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_ROOT"

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) VENV_BIN=Scripts ;;
    *) VENV_BIN=bin ;;
esac

info() { printf "\n==> %s\n" "$1"; }
warn() { printf "==> %s\n" "$1" >&2; }
err()  { printf "==> %s\n" "$1" >&2; }
ask()  { printf "\n ?  %s %s " "$1" "$2"; }

setup_venv() {
    dir="$1"
    if [ ! -d "$dir" ]; then
        err "Error: directory '$dir' not found. Try re-cloning the repository."
        exit 1
    fi

    venv="$dir/venv"
    if [ ! -d "$venv" ]; then
        info "Creating venv in $venv"
        python3 -m venv "$venv"
    fi

    if [ -f "$dir/requirements.txt" ]; then
        info "Installing requirements for $dir"
        "$venv/$VENV_BIN/python" -m pip install --upgrade pip
        "$venv/$VENV_BIN/python" -m pip install --upgrade -r "$dir/requirements.txt"
    else
        warn "Warning: $dir/requirements.txt not found, skipping. If the program doesn't work, try re-downloading."
    fi
}

cmd_setup() {
    # Check python3
    if ! command -v python3 >/dev/null 2>&1; then
        err "Error: python3 is not installed. Please install it and re-run."
        exit 1
    fi

    # Ensure pip is available for python3 (venv module needs ensurepip)
    if ! python3 -m pip --version >/dev/null 2>&1; then
        err "Error: pip for python3 is not available. Please install python3-pip."
        exit 1
    fi

    # Set up venvs
    setup_venv "pixiv"
    setup_venv "auth"

    # Install Playwright browsers (auth/ uses Playwright)
    if [ -x auth/venv/$VENV_BIN/playwright ]; then
        info "Installing Playwright Chromium browser"
        auth/venv/$VENV_BIN/playwright install chromium
    fi

    # Ensure .env exists
    reset_env=0
    if [ -f .env ]; then
        if [ -t 0 ]; then
            ask "A .env already exists. Reset it?" "[y/N]"
            read -r reply
            case "$reply" in
                [yY]|[yY][eE][sS]) reset_env=1 ;;
            esac
        else
            # Non-TTY
            info "A .env already exists."
        fi
    fi

    if [ ! -f .env ] || [ "$reset_env" -eq 1 ]; then
        if [ -f example.env ]; then
            info "Creating .env from example.env"
            cp example.env .env
        else
            info "Creating empty .env"
            touch .env
        fi
    fi

    info "Setup complete. Make sure to log in, then run '$0 download'!"

    # Offer to continue to login
    if [ -t 0 ]; then
        ask "Log into Pixiv now?" "[Y/n]"
        read -r reply
        case "$reply" in
            [nN]|[nN][oO]) return 0 ;;
        esac
        cmd_login
    fi
}

cmd_login() {
    if [ ! -x auth/venv/$VENV_BIN/python ]; then
        err "Error: auth/venv not found. Run '$0 setup' first."
        exit 1
    fi

    if [ ! -f auth/main.py ]; then
        err "Error: auth/main.py not found."
        exit 1
    fi

    exec auth/venv/$VENV_BIN/python auth/main.py
}

cmd_download() {
    if [ ! -x pixiv/venv/$VENV_BIN/python ]; then
        err "Error: pixiv/venv not found. Run '$0 setup' first."
        exit 1
    fi

    if [ ! -f pixiv/main.py ]; then
        err "Error: pixiv/main.py not found. Try re-cloning the repo."
        exit 1
    fi

    exec pixiv/venv/$VENV_BIN/python pixiv/main.py
}

cmd_clean() {
    if [ -x auth/venv/$VENV_BIN/playwright ]; then
        auth/venv/$VENV_BIN/playwright uninstall
    fi
    rm -rf auth/venv
    rm -rf auth/__pycache__
    rm -rf pixiv/venv
    rm -rf pixiv/__pycache__
}

cmd_restore() {
    if command -v git >/dev/null 2>&1; then
        git reset --hard HEAD
    fi
}

cmd_repair() {
    cmd_clean
    cmd_restore
    cmd_setup
}

cmd_reset() {
    reset_conf=0
    if [ -t 0 ]; then
        ask "Reset pixiv-vault config? This will not delete your vault." "[y/N]"
        read -r reply
        case "$reply" in
            [yY]|[yY][eE][sS]) reset_conf=1 ;;
        esac
    else
        reset_conf=1
    fi

    [ "$reset_conf" = 1 ] || return 0

    rm -f .env
}

cmd_purge() {
    cmd_clean
    cmd_reset
}

usage() {
    cat <<EOF >&2
Usage: $0 {setup|login|download|clean|repair|reset|purge}
  setup - install dependencies and create configuration
  login - log into Pixiv and store credentials
  download - start a download according to .env config
  clean - remove installed files (setup must be run again)
  repair - run clean, restore modified files, then run setup
  reset - delete configuration
  purge - macro for clean + reset

Note: No command will ever remove downloaded works! Your vault is safe.
      If you would like to remove your vault, simply delete the folder.
EOF
    exit 1
}

[ $# -eq 1 ] || usage
case "$1" in
    setup) cmd_setup ;;
    login|auth) cmd_login ;;
    download) cmd_download ;;
    clean) cmd_clean ;;
    repair) cmd_repair ;;
    reset) cmd_reset ;;
    purge) cmd_purge ;;
    *)     usage ;;
esac
