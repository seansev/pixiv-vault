#!/bin/sh

set -eu

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_ROOT"

usage() {
    echo "Usage: $0 {setup|login}" >&2
    exit 1
}

setup_venv() {
    dir="$1"
    if [ ! -d "$dir" ]; then
        echo "Error: directory '$dir' not found. Try re-cloning the repository." >&2
        exit 1
    fi

    venv="$dir/venv"
    if [ ! -d "$venv" ]; then
        echo "Creating venv in $venv..."
        python3 -m venv "$venv"
    fi

    if [ -f "$dir/requirements.txt" ]; then
        echo "Installing requirements for $dir..."
        "$venv/bin/pip" install --upgrade pip
        "$venv/bin/pip" install -r "$dir/requirements.txt"
    else
        echo "Warning: $dir/requirements.txt not found, skipping. If the program doesn't work, try re-downloading." >&2
    fi
}

cmd_setup() {
    # Check python3
    if ! command -v python3 >/dev/null 2>&1; then
        echo "Error: python3 is not installed. Please install it and re-run." >&2
        exit 1
    fi

    # Ensure pip is available for python3 (venv module needs ensurepip)
    if ! python3 -m pip --version >/dev/null 2>&1; then
        echo "Error: pip for python3 is not available. Please install python3-pip." >&2
        exit 1
    fi

    # Set up venvs
    setup_venv "pixiv"
    setup_venv "auth"

    # Ensure .env exists
    reset_env=0
    if [ -f .env ]; then
        if [ -t 0 ]; then
            printf "A .env already exists. Reset it? [y/N] "
            read -r reply
            case "$reply" in
                [yY]|[yY][eE][sS]) reset_env=1 ;;
            esac
        else
            # Non-TTY
            echo "A .env already exists."
        fi
    fi

    if [ ! -f .env ] || [ "$reset_env" -eq 1 ]; then
        if [ -f example.env ]; then
            echo "Creating .env from example.env..."
            cp example.env .env
        else
            echo "Creating empty .env..."
            touch .env
        fi
    fi

    # Offer to continue to login
    if [ -t 0 ]; then
        printf "Log into Pixiv now? [Y/n] "
        read -r reply
        case "$reply" in
            [nN]|[nN][oO]) return 0 ;;
        esac
        cmd_login
    fi

    echo "Setup complete."
}

cmd_login() {
    if [ ! -x auth/venv/bin/python ]; then
        echo "Error: auth/venv not found. Run '$0 setup' first." >&2
        exit 1
    fi
    if [ ! -f auth/main.py ]; then
        echo "Error: auth/main.py not found." >&2
        exit 1
    fi
    exec auth/venv/bin/python auth/main.py
}

[ $# -eq 1 ] || usage

case "$1" in
    setup) cmd_setup ;;
    login|auth) cmd_login ;;
    *)     usage ;;
esac
